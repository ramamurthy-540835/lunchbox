# Use a dedicated Google Cloud/Firebase project that is not the V1 project.
LUNCHBOX_ENV=v2
LUNCHBOX_VERSION=2
LUNCHBOX_V2_PROJECT_ID=your-dedicated-v2-project-id
GCP_PROJECT_ID=your-dedicated-v2-project-id
FIREBASE_PROJECT_ID=your-dedicated-v2-project-id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-dedicated-v2-project-id
FIRESTORE_DATABASE_ID=(default)
BIGQUERY_DATASET=lunchbox_v2_orders
BIGQUERY_ORDERS_TABLE=orders_v2
SCHOOL_DIRECTORY_BIGQUERY_DATASET=school_directory_v2
GCS_BUCKET=lunchbox-v2-your-unique-suffix

# Set these only to the V2 Firebase Web app's public configuration values.
NEXT_PUBLIC_FIREBASE_API_KEY=your-v2-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-dedicated-v2-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=your-v2-web-app-id
NEXT_PUBLIC_LUNCHBOX_ENV=v2

REQUIRE_FIREBASE_AUTH=true
ENABLE_PAYMENTS=false
FRANCHISE_PAYMENT_ENABLED=false
